# Template — installed by deploy/install.sh with @USER@/@ROOT@/@CLAUDE_BIN@ substituted.
[Unit]
Description=newsbot dispatcher (telegram + cron + jobs + claude subprocesses)
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=@USER@
WorkingDirectory=@ROOT@
EnvironmentFile=@ROOT@/.env
# Fallbacks when .env doesn't set them. NOTE: EnvironmentFile overrides Environment,
# so a leftover compose-era NEO4J_URI=bolt://neo4j:7687 in .env must be removed.
Environment=NEO4J_URI=bolt://localhost:7687
Environment=WORKSPACE_DIR=@ROOT@/workspace
# systemd units get a minimal PATH; runner.py resolves the claude CLI via CLAUDE_BIN.
Environment=CLAUDE_BIN=@CLAUDE_BIN@
# After=docker.service only waits for the docker daemon, not for the neo4j
# container to be healthy — wait for bolt to actually accept before starting
# (replaces compose's depends_on: service_healthy).
ExecStartPre=@ROOT@/.venv/bin/python -m newsparser.scripts.wait_neo4j
ExecStart=@ROOT@/.venv/bin/python -m newsparser.dispatcher
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
