# Template — installed by deploy/install.sh with @USER@/@ROOT@ substituted.
[Unit]
Description=newsbot poller (article collection)
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=@USER@
WorkingDirectory=@ROOT@
EnvironmentFile=@ROOT@/.env
# Fallback when .env doesn't set it. NOTE: EnvironmentFile overrides Environment,
# so a leftover compose-era NEO4J_URI=bolt://neo4j:7687 in .env must be removed.
Environment=NEO4J_URI=bolt://localhost:7687
ExecStart=@ROOT@/.venv/bin/python -m newsparser.collector.run_poller
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
